# Application Configuration
PROJECT_NAME="ClientTracker"
ENVIRONMENT="development"
APP_URL="http://localhost:8000"
SECRET_KEY="replace_with_a_secure_random_secret_key"

# Database Configuration (MongoDB)
MONGODB_URL="mongodb://localhost:27017/clienttracker"

# Hybrid AI & Machine Learning Configuration
# In-House Local Model Settings
ML_MODEL_PATH="ml/models/conversion_model.pkl"
ENABLE_LOCAL_ML=true

# Cloud LLM Orchestration Gateway (Optional - for deep reasoning & executive drafting)
LLM_PROVIDER="openai" # options: openai, groq, anthropic, ollama
LLM_API_KEY="your_api_key_here"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TEMPERATURE=0.3

# Google OAuth & Calendar Integration (Optional)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/calendar/google/callback"

# SMTP Email Notification Service (Optional)
MAIL_USERNAME="notifications@example.com"
MAIL_PASSWORD="your_app_specific_password"
MAIL_FROM="notifications@example.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_TLS=true
MAIL_SSL=false
USE_CREDENTIALS=true
